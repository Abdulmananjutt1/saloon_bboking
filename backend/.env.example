# Glamour Studio Backend - Environment Variables

# Railway PostgreSQL
# On Railway set this to: ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://user:password@localhost:5432/glamour_studio"

# Auth
# Generate a strong value for production, e.g. `openssl rand -base64 32`
JWT_SECRET="change-me-to-a-long-random-secret"

# Server
# Railway injects PORT automatically. Keep this for local development only.
PORT=4000
NODE_ENV="development"
DB_POOL_MAX=5

# Public backend URL
# Optional on Railway because RAILWAY_PUBLIC_DOMAIN is auto-provided after you generate a domain.
PUBLIC_BACKEND_URL="http://localhost:4000"

# Frontend / CORS / email links
APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
FRONTEND_URLS="http://localhost:3000,http://localhost:3001"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Email - Resend (optional)
RESEND_API_KEY=""
EMAIL_FROM="Glamour Studio <onboarding@resend.dev>"
ADMIN_EMAIL=""

# Web Push (optional)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL="mailto:admin@glamourstudio.com"

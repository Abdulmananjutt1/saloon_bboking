// ════════════════════════════════════════
//  Prisma Schema — Glamour Studio
// ════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
//  User
// ─────────────────────────────────────────
model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String
  passwordHash String
  role         UserRole  @default(CLIENT)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  bookings     Booking[]
  reviews      Review[]

  @@map("users")
}

enum UserRole {
  ADMIN
  CLIENT
}

// ─────────────────────────────────────────
//  Service
// ─────────────────────────────────────────
model Service {
  id              String          @id @default(cuid())
  name            String
  slug            String          @unique
  category        ServiceCategory
  description     String
  duration        Int
  price           Int
  discountedPrice Int?
  image           String
  popular         Boolean         @default(false)
  forGender       Gender          @default(UNISEX)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  bookings        Booking[]

  @@map("services")
}

enum ServiceCategory {
  HAIRCUT
  BEARD
  COLOR
  FACIAL
  MASSAGE
  NAILS
  BRIDAL
  WAXING
  KERATIN
}

enum Gender {
  MALE
  FEMALE
  UNISEX
}

// ─────────────────────────────────────────
//  Stylist
// ─────────────────────────────────────────
model Stylist {
  id          String    @id @default(cuid())
  name        String
  role        String
  avatar      String
  bio         String
  experience  Int
  rating      Float     @default(0)
  reviewCount Int       @default(0)
  available   Boolean   @default(true)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  specialties StylistSpecialty[]
  slots       StylistSlot[]
  bookings    Booking[]
  reviews     Review[]

  @@map("stylists")
}

model StylistSpecialty {
  id        String  @id @default(cuid())
  stylistId String
  name      String

  stylist   Stylist @relation(fields: [stylistId], references: [id], onDelete: Cascade)

  @@map("stylist_specialties")
}

model StylistSlot {
  id        String  @id @default(cuid())
  stylistId String
  time      String

  stylist   Stylist @relation(fields: [stylistId], references: [id], onDelete: Cascade)

  @@map("stylist_slots")
}

// ─────────────────────────────────────────
//  Client
// ─────────────────────────────────────────
model Client {
  id          String    @id @default(cuid())
  name        String
  email       String    @unique
  phone       String
  notes       String?
  totalVisits Int       @default(0)
  totalSpent  Int       @default(0)
  lastVisit   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  bookings    Booking[]

  @@map("clients")
}

// ─────────────────────────────────────────
//  Booking
// ─────────────────────────────────────────
model Booking {
  id            String        @id @default(cuid())
  customerName  String
  customerEmail String
  customerPhone String
  serviceId     String
  stylistId     String
  clientId      String?
  userId        String?
  date          DateTime
  time          String
  duration      Int
  price         Int
  notes         String?
  status        BookingStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  service       Service       @relation(fields: [serviceId], references: [id])
  stylist       Stylist       @relation(fields: [stylistId], references: [id])
  client        Client?       @relation(fields: [clientId], references: [id])
  user          User?         @relation(fields: [userId], references: [id])

  @@map("bookings")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

// ─────────────────────────────────────────
//  Review
// ─────────────────────────────────────────
model Review {
  id           String   @id @default(cuid())
  customerName String
  comment      String
  rating       Int
  serviceName  String
  userId       String?
  stylistId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User?    @relation(fields: [userId], references: [id])
  stylist      Stylist? @relation(fields: [stylistId], references: [id])

  @@map("reviews")
}

// ─────────────────────────────────────────
//  Gallery
// ─────────────────────────────────────────
model GalleryImage {
  id        String          @id @default(cuid())
  src       String
  caption   String?
  category  ServiceCategory
  sortOrder Int             @default(0)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())

  @@map("gallery_images")
}

// ─────────────────────────────────────────
//  Push Subscriptions
// ─────────────────────────────────────────
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String?  // null for guest/anonymous clients
  roomId    String?  // for client chat room identification
  email     String?  // to match clients by email
  role      String   @default("client") // "admin" | "client"
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("push_subscriptions")
}

// ─────────────────────────────────────────
//  Chat
// ─────────────────────────────────────────
model ChatMessage {
  id        String   @id @default(cuid())
  roomId    String   // client email — uniquely identifies the chat room
  sender    String   // "admin" | client email
  senderName String  @default("User")
  text      String
  createdAt DateTime @default(now())

  @@index([roomId])
  @@map("chat_messages")
}
